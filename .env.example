GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# services/api — Postgres connection (overrides services/api/alembic.ini's
# sqlalchemy.url when set; see services/api/alembic/env.py).
DATABASE_URL=postgresql://cirq_sandbox:cirq_sandbox@localhost:5432/cirq_sandbox

# services/api — Google OAuth + JWT auth (see services/api/app/auth.py).
# GOOGLE_OAUTH_REDIRECT_URI is this API's own /auth/google/callback URL, as
# registered in the Google Cloud OAuth client config.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
JWT_SECRET_KEY=
# The client app's base URL — /auth/google/callback redirects here on success
# (/auth/callback?token=<jwt>) and on failure (/login?error=<reason>).
CLIENT_BASE_URL=http://localhost:8081

# services/api — run queue (see services/api/app/redis_client.py,
# services/api/app/worker.py).
REDIS_URL=redis://localhost:6379/0
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=120
